{
  "bundle_id": "sepsis-sofa",
  "version": "0.3.0",
  "indicator": "sepsis",
  "description": "SOFA-style sepsis thresholds with Vincent cardiovascular ladder; governance locked to Challenge 2019 setA winner (grid_p0_r90_b0) dual-lane page gate (prototype \u2014 not clinically validated)",
  "citations": [
    "Vincent JL et al. The SOFA (Sepsis-related Organ Failure Assessment) score. Crit Care Med. 1998.",
    "Singer M et al. The Third International Consensus Definitions for Sepsis and Septic Shock (Sepsis-3). JAMA. 2016."
  ],
  "score": {
    "type": "sofa",
    "components": [
      "respiration",
      "coagulation",
      "liver",
      "cardiovascular",
      "cns",
      "renal"
    ],
    "missing_policy": "partial_with_missing_components",
    "min_components_required": 3,
    "component_thresholds": {
      "respiration": {
        "ratio_source": "pao2_fio2 preferred else spo2_fio2",
        "params": {
          "p4_ratio_lt": 100,
          "p3_ratio_lt": 200,
          "p2_ratio_lt": 300,
          "p1_ratio_lt": 400
        },
        "bands": [
          {
            "points": 4,
            "rule": "ratio < 100 AND mechanically_ventilated"
          },
          {
            "points": 3,
            "rule": "ratio < 200 AND mechanically_ventilated"
          },
          {
            "points": 2,
            "rule": "ratio < 300"
          },
          {
            "points": 1,
            "rule": "ratio < 400"
          },
          {
            "points": 0,
            "rule": "ratio >= 400"
          }
        ]
      },
      "coagulation": {
        "unit": "platelets 10^9/L",
        "bands": [
          {
            "points": 4,
            "max_exclusive": 20
          },
          {
            "points": 3,
            "max_exclusive": 50
          },
          {
            "points": 2,
            "max_exclusive": 100
          },
          {
            "points": 1,
            "max_exclusive": 150
          },
          {
            "points": 0,
            "min_inclusive": 150
          }
        ]
      },
      "liver": {
        "unit": "bilirubin mg/dL",
        "bands": [
          {
            "points": 4,
            "min_inclusive": 12.0
          },
          {
            "points": 3,
            "min_inclusive": 6.0
          },
          {
            "points": 2,
            "min_inclusive": 2.0
          },
          {
            "points": 1,
            "min_inclusive": 1.2
          },
          {
            "points": 0,
            "max_exclusive": 1.2
          }
        ]
      },
      "cardiovascular": {
        "map_mmhg_lt": 70,
        "map_mmhg_lt_70_points": 1,
        "params": {
          "dopamine_p2_max_inclusive": 5,
          "dopamine_p3_max_inclusive": 15,
          "epi_norepi_p3_max_inclusive": 0.1,
          "unknown_dose_points": 3
        },
        "vasopressor_ladder": [
          {
            "points": 2,
            "rule": "dopamine <= 5 ug/kg/min OR any dobutamine"
          },
          {
            "points": 3,
            "rule": "dopamine > 5 OR epi/norepi <= 0.1 ug/kg/min OR unknown dose"
          },
          {
            "points": 4,
            "rule": "dopamine > 15 OR epi/norepi > 0.1 ug/kg/min"
          }
        ]
      },
      "cns": {
        "unit": "GCS",
        "bands": [
          {
            "points": 4,
            "gcs_lt": 6
          },
          {
            "points": 3,
            "gcs_le": 9
          },
          {
            "points": 2,
            "gcs_le": 12
          },
          {
            "points": 1,
            "gcs_le": 14
          },
          {
            "points": 0,
            "gcs_eq": 15
          }
        ]
      },
      "renal": {
        "creatinine_mg_dl": [
          {
            "points": 4,
            "min_inclusive": 5.0
          },
          {
            "points": 3,
            "min_inclusive": 3.5
          },
          {
            "points": 2,
            "min_inclusive": 2.0
          },
          {
            "points": 1,
            "min_inclusive": 1.2
          },
          {
            "points": 0,
            "max_exclusive": 1.2
          }
        ],
        "urine_output_ml_day": [
          {
            "points": 4,
            "max_exclusive": 200
          },
          {
            "points": 3,
            "max_exclusive": 500
          },
          {
            "points": 0,
            "min_inclusive": 500
          }
        ],
        "combine": "max(creatinine_points, urine_points)"
      }
    }
  },
  "alert": {
    "naive_threshold": 2,
    "severity_bands": [
      {
        "min": 2,
        "max": 3,
        "tier": "watch"
      },
      {
        "min": 4,
        "max": 6,
        "tier": "urgent"
      },
      {
        "min": 7,
        "max": 24,
        "tier": "critical"
      }
    ]
  },
  "governance": {
    "trajectory": {
      "min_persistence_minutes": 0,
      "min_crossings": 1
    },
    "baseline": {
      "enabled": false,
      "lookback_hours": 24,
      "delta_threshold": 2
    },
    "suppression": {
      "flags": [
        "comfort_care",
        "already_on_sepsis_protocol"
      ]
    },
    "dedup": {
      "refractory_minutes": 90,
      "resolution_gap_minutes": 60
    },
    "tiering": {
      "interruptive_tiers": [
        "urgent",
        "critical"
      ],
      "passive_tiers": [
        "watch"
      ]
    },
    "page_gate": {
      "enabled": true,
      "min_crossings": 2,
      "trajectory_persistence_minutes": 30,
      "min_score_delta": 1,
      "min_positive_components": 2
    },
    "operating_point": {
      "source": "eval/challenge2019/frozen/p1_setA_winner.json",
      "candidate_id": "grid_p0_r90_b0"
    }
  }
}
