{
  "bundle_id": "sepsis-sofa",
  "version": "0.1.0",
  "indicator": "sepsis",
  "description": "Draft SOFA-style sepsis thresholds (prototype — not clinically validated)",
  "score": {
    "type": "sofa",
    "components": [
      "respiration",
      "coagulation",
      "liver",
      "cardiovascular",
      "cns",
      "renal"
    ],
    "missing_policy": "partial_with_missing_components"
  },
  "alert": {
    "naive_threshold": 2,
    "severity_bands": [
      { "min": 2, "max": 3, "tier": "watch" },
      { "min": 4, "max": 6, "tier": "urgent" },
      { "min": 7, "max": 24, "tier": "critical" }
    ]
  },
  "governance": {
    "trajectory": {
      "min_persistence_minutes": 30,
      "min_crossings": 2
    },
    "baseline": {
      "enabled": true,
      "lookback_hours": 24,
      "delta_threshold": 2
    },
    "suppression": {
      "flags": ["comfort_care", "already_on_sepsis_protocol"]
    },
    "dedup": {
      "refractory_minutes": 120
    },
    "tiering": {
      "interruptive_tiers": ["urgent", "critical"],
      "passive_tiers": ["watch"]
    }
  }
}
