{
  "bundle_id": "resp-deterioration",
  "version": "0.1.0",
  "indicator": "respiratory-deterioration",
  "description": "Deterministic hypoxemic/ventilatory deterioration using oxygenation ratios, respiratory rate, oxygen-support escalation, and optional ABG context (prototype — not clinically validated). Reuses shared governance and episode arbitration.",
  "citations": [
    "Vincent JL et al. The SOFA (Sepsis-related Organ Failure Assessment) score. Intensive Care Med. 1996. (ratio cutoffs only — not a SOFA claim)",
    "ARDS Definition Task Force. Acute respiratory distress syndrome: the Berlin Definition. JAMA. 2012. (severity framing only)"
  ],
  "score": {
    "type": "resp_hypoxemia",
    "inputs": [
      "spo2_percent",
      "pao2_mmhg",
      "fio2_fraction",
      "pao2_fio2",
      "spo2_fio2",
      "room_air",
      "respiratory_rate",
      "oxygen_device",
      "mechanically_ventilated",
      "abg_ph",
      "paco2_mmhg"
    ],
    "missing_policy": "partial_with_missing_components",
    "min_components_required": 1,
    "ratio_source": "pao2_fio2 preferred else spo2_fio2; SpO2 alone never assumes ambient FiO2 unless room_air=true",
    "combine": "max(oxygenation_stage, rate_stage, support_stage, blood_gas_stage)",
    "stages": [
      {
        "stage": 0,
        "score": 0,
        "rule": "no_respiratory_deterioration"
      },
      {
        "stage": 1,
        "score": 2,
        "rule": "mild_hypoxemia_or_tachypnea_or_low_flow_o2_or_mild_abg"
      },
      {
        "stage": 2,
        "score": 4,
        "rule": "moderate_hypoxemia_or_rr_ge_30_or_high_flow_niv_or_worse_abg"
      },
      {
        "stage": 3,
        "score": 6,
        "rule": "severe_hypoxemia_or_rr_ge_35_or_invasive_vent_or_ph_lt_7_20"
      }
    ],
    "oxygenation_cutoffs": {
      "ratio_lt_400": 1,
      "ratio_lt_300": 2,
      "ratio_lt_200": 2,
      "ratio_lt_200_ventilated": 3,
      "ratio_lt_100": 3
    },
    "rate_cutoffs": {
      "rr_ge_22": 1,
      "rr_ge_30": 2,
      "rr_ge_35": 3
    },
    "support_devices": {
      "none": 0,
      "nasal_cannula": 1,
      "face_mask": 1,
      "high_flow": 2,
      "non_invasive": 2,
      "invasive": 3
    }
  },
  "alert": {
    "naive_threshold": 2,
    "severity_bands": [
      {
        "min": 2,
        "max": 3,
        "tier": "watch"
      },
      {
        "min": 4,
        "max": 5,
        "tier": "urgent"
      },
      {
        "min": 6,
        "max": 24,
        "tier": "critical"
      }
    ]
  },
  "governance": {
    "trajectory": {
      "min_persistence_minutes": 30,
      "min_crossings": 2
    },
    "baseline": {
      "enabled": false
    },
    "suppression": {
      "flags": [
        "comfort_care",
        "already_on_vent_protocol",
        "chronic_home_vent"
      ]
    },
    "dedup": {
      "refractory_minutes": 180,
      "resolution_gap_minutes": 60
    },
    "tiering": {
      "interruptive_tiers": [
        "urgent",
        "critical"
      ],
      "passive_tiers": [
        "watch"
      ]
    },
    "page_gate": {
      "enabled": true,
      "min_crossings": 2,
      "trajectory_persistence_minutes": 30,
      "min_score_delta": 1,
      "min_positive_components": 1
    }
  }
}
