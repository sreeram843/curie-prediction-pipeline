KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FLINK_UI=http://localhost:8081
SYNTHEA_OUTPUT=data/synthea/fhir

# PhysioNet MIMIC-IV Clinical Database Demo (open). Place under data/mimic-iv-demo/
# or override:
# CURIE_MIMIC_DEMO_DIR=/absolute/path/to/mimic-iv-demo
CURIE_MIMIC_DEMO_DIR=data/mimic-iv-demo

# Phase 2 feature flags (off by default — deterministic alerting never depends on these)
CURIE_ENABLE_EXTRACTION=false
CURIE_EXTRACTION_BACKEND=deterministic
CURIE_ENABLE_GRP=false
CURIE_GRP_BACKEND=deterministic
CURIE_GRP_MODEL_NAME=curie-grp-stub-v1
CURIE_GRP_FAIL_CLOSED=true

# OpenAI-compatible GRP (LM Studio example)
# CURIE_ENABLE_GRP=true
# CURIE_GRP_BACKEND=openai_compat
# CURIE_GRP_BASE_URL=http://127.0.0.1:1234/v1
# CURIE_GRP_API_KEY=lm-studio
# CURIE_GRP_MODEL_NAME=medgemma-4b-it-mlx
# CURIE_GRP_TIMEOUT_S=120

# Live Flink alerts → API (requires pip install -e ".[kafka]")
# CURIE_KAFKA_ALERTS_CONSUMER=true
# CURIE_CLEAR_DEMO_ON_LIVE=true
# CURIE_KAFKA_ALERTS_GROUP=curie-api-alerts-v1

# Production: require explicit rule-bundle versions (no activation "latest")
# CURIE_REQUIRE_EXPLICIT_RULE_VERSION=1
