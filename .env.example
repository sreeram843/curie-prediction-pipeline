KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FLINK_UI=http://localhost:8081
SYNTHEA_OUTPUT=data/synthea/fhir

# Phase 2 feature flags (off by default — deterministic alerting never depends on these)
CURIE_ENABLE_EXTRACTION=false
CURIE_EXTRACTION_BACKEND=deterministic
CURIE_ENABLE_GRP=false
CURIE_GRP_BACKEND=deterministic
CURIE_GRP_MODEL_NAME=curie-grp-stub-v1
CURIE_GRP_FAIL_CLOSED=true
